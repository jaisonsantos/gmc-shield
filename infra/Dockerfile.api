# infra/Dockerfile.api

# Base mais nova, geralmente com menos CVEs abertas
FROM python:3.11-slim-bookworm

# Evita caches e arquivos pyc desnecessários
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# Instala somente o necessário, sem recommends
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl git libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Primeiro só as deps pra aproveitar cache
COPY api/requirements.txt /app/requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /app/requirements.txt \
    && python -m playwright install --with-deps chromium

# (Se você quiser copiar código no build; em runtime você já monta volume ./api:/app)
# COPY api/ /app

# (Opcional) rodar como usuário não-root
# RUN useradd -m app && chown -R app:app /app
# USER app
