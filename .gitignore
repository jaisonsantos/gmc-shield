cat > .gitignore << 'EOF'
# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.py[cod]
*.egg-info/
.venv/
api/.venv/

# --- GMC Shield local ---
api/artifacts/
worker/artifacts/
artifacts/

# Node / Web
node_modules/
web/node_modules/
web/dist/

# Env & secrets
.env
*.env
api/.env
web/.env
web/.env.local
.env.local

# Misc
coverage/
EOF
